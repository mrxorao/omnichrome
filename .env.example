# ==========================================
# OmniChrome Environment Configuration
# Copy this file to .env and adjust variables
# ==========================================

# Display & Resolution
RESOLUTION_WIDTH=1366
RESOLUTION_HEIGHT=768
TZ=UTC

# Automatic Google Chrome updates on container startup (true / false)
AUTO_UPDATE=true

# Optional HTTP/SOCKS Proxy (e.g., http://user:password@ip:port or socks5://ip:port)
PROXY_SERVER=

# Optional VNC/noVNC Password (leave blank for no authentication)
VNC_PASSWORD=

# Host Port Mappings
PORT_NOVNC=6080
PORT_VNC=5900
PORT_CDP=9222
